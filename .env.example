# Copy this file to .env and fill in your values.
# Variables prefixed with EXPO_PUBLIC_ are embedded in the JS bundle at build time.
# Do NOT commit .env to git — it is already in .gitignore.

# The live backend URL used for preview and production builds.
# Example: https://smartcare-api.onrender.com
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_URL_HERE
