{
  "expo": {
    "name": "SmartCare Mobile",
    "slug": "smartcare-mobile",
    "scheme": "smartcare-mobile",
    "platforms": ["ios", "android", "web"],
    "version": "1.0.0",
    "icon": "./assets/icon.jpg",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/icon.jpg",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.smartcare.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#0f4c81"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/icon.jpg"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"]
  }
}
